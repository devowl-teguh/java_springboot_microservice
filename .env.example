# Copy to .env (gitignored) and fill in:  cp .env.example .env
# Plain KEY=value lines: no quotes and no "export". Both Spring Boot (./mvnw spring-boot:run) and
# Docker Compose (docker compose --profile app up) read this file.

# --- Database: pick ONE block ---------------------------------------------------------------

# A) Local Postgres from Docker Compose (docker compose --profile local-db up -d)
DB_URL=jdbc:postgresql://localhost:5433/transactions
DB_USERNAME=transactions
DB_PASSWORD=transactions
# Used only by the app container (docker compose --profile app), which reaches Postgres by service name.
APP_DB_URL=jdbc:postgresql://postgres:5432/transactions

# B) Supabase (session pooler, port 5432; avoid the 6543 transaction pooler, which breaks Flyway).
#    Flyway creates the transaction_service schema and its tables in this database on first start.
#    Password: Supabase dashboard -> Project Settings -> Database.
#    Host and user: Supabase dashboard -> Connect -> Session pooler.
# DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=

# --- Kafka (from Docker Compose) ------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions-v1

# --- Optional -------------------------------------------------------------------------------
# OUTBOX_DELAY_MS=1000
# OPENAPI_SERVER_URL=http://localhost:8080
# API_DOCS_ENABLED=true
